# ---------------------------------------------------------------------------
# Faithful Word Music - environment variables
#
# Copy this file to .env.local and fill in real values for local development:
#     cp .env.example .env.local
#
# .env.local is git-ignored and must NEVER be committed.
# This file (.env.example) contains PLACEHOLDERS ONLY and is safe to commit.
#
# All variables below are SERVER-ONLY secrets. They are deliberately NOT
# prefixed with NEXT_PUBLIC_, because anything prefixed with NEXT_PUBLIC_ is
# bundled into the browser JavaScript and must be treated as public.
#
# In production these are set in:
#     Vercel -> Project -> Settings -> Environment Variables
# ---------------------------------------------------------------------------

# Resend API key - powers the /contact form.
# Create at https://resend.com/api-keys  (starts with "re_")
# Needed in: Development, Preview, Production
RESEND_API_KEY=your_resend_api_key_here

# RETIRED. The song list is now built in the Service Planner. This key only
# lets the one-time import (/api/cron/import-sheet-schedule) read the old
# "PUBLIC Song List" Google Sheet. Delete it once that import has run.
# (Not the Sheet Music Index - that uses the service account below.)
GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here

# Neon Postgres connection string - the song list (Service Planner), the
# permanent song archive and member accounts.
# Added automatically when Neon is connected in Vercel -> Storage; pull it with
#     npx vercel env pull .env.local
# Without it the song list shows a "not connected" message.
# Needed in: Development, Preview, Production
DATABASE_URL=your_neon_database_url_here

# Shared secret for the cron jobs (/api/cron/...).
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>". Any long random string.
# Needed in: Production (and locally if you run the sync by hand)
CRON_SECRET=your_cron_secret_here

# Google service account - reads the PRIVATE Sheet Music Index and sheet-music
# files in Drive for the song pages (src/lib/google-auth.ts). Both come from the
# service account's JSON key file: "client_email" and "private_key".
# Optional: without them the song pages simply have no sheet-music section.
# Needed in: Development, Preview, Production
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com

# The private key, including the BEGIN/END lines. Either form works:
#   - in Vercel: paste it with real line breaks;
#   - in .env.local: one line in double quotes with \n for each line break,
#     exactly as it appears in the JSON file.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Member accounts - Clerk (invite-only). See README -> "Accounts (Clerk)".
#
# Clerk has TWO separate instances with SEPARATE users. Use the right pair:
#
#   .env.local (your machine)  -> Development keys  pk_test_... / sk_test_...
#   Vercel "Preview"           -> Development keys  pk_test_... / sk_test_...
#   Vercel "Production"        -> Production keys   pk_live_... / sk_live_...
#
# Never put the live keys in .env.local or in Vercel's Preview/Development
# environments. The site checks this at runtime and switches accounts off
# (the public site keeps working) if test keys reach Production or live keys
# appear anywhere else - see src/lib/auth/clerk-env.ts.
#
# Leave both empty and the site runs exactly as before, with accounts off.
#
# Find them at https://dashboard.clerk.com -> your app -> (instance switcher:
# Development / Production) -> Configure -> API keys.
# ---------------------------------------------------------------------------

# PUBLIC (safe in the browser - it identifies the Clerk instance, nothing more).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_development_publishable_key_pk_test

# SERVER-ONLY secret. Full admin access to your Clerk users - never share it.
CLERK_SECRET_KEY=your_clerk_development_secret_key_sk_test
